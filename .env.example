# mock-pontes environment configuration (example)
# Copy to `.env` and adjust as needed.

# HTTP(S) listener
PORT=3001
HOST=0.0.0.0

# Optional Redis backing store for runtime PKI and enrolled users.
# When unset, mock-pontes keeps state in memory (single-replica only).
REDIS_URL=redis://localhost:6379

# TLS server certificate subject alternative names and subject.
TLS_SAN="dns:localhost;ip:127.0.0.1"
TLS_SUBJECT="CN=localhost O=MockPontes C=DEV"

# Admin-surface gate. UNSET BY DEFAULT — while unset, POST /admin/reset,
# PUT /admin/business-window and GET /admin/enrolled-users are OPEN.
# Set this on any published/public instance (presented via the X-Admin-Token
# header or Authorization: Bearer <token>).
# ADMIN_TOKEN=change-me

# Business-window enforcement (issue #59). When "true", mutating official API
# calls (POST/PUT/... on /dlt/*, /igw/*) are rejected with 403 HL-BW-001 outside
# the window; openTime/closeTime are interpreted in Frankfurt (Europe/Berlin)
# time. Off by default so local seeding is never blocked.
# PONTES_MOCK_ENFORCE_BUSINESS_WINDOW=true
