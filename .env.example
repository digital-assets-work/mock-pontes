# mock-pontes environment configuration (example)
# Copy to `.env` and adjust as needed.

# HTTP(S) listener
PORT=3001
# Bind address. 127.0.0.1 (loopback) keeps the mock — and its credential-minting
# runtime CA — reachable only from THIS machine, the safe default for local dev.
# Inside a container (or to expose it on the LAN) set 0.0.0.0; the Docker image
# and Helm deployment already override HOST to 0.0.0.0 via their own env.
HOST=127.0.0.1

# Optional Redis backing store for runtime PKI and enrolled users.
# UNSET BY DEFAULT — mock-pontes keeps state in memory (single-replica), so it
# starts with zero external services. Uncomment to persist state / run multiple
# replicas; when set, mock-pontes fails fast at startup if Redis is unreachable.
# REDIS_URL=redis://localhost:6379

# TLS server certificate subject alternative names and subject.
TLS_SAN="dns:localhost;ip:127.0.0.1"
TLS_SUBJECT="CN=localhost O=MockPontes C=DEV"

# Admin-surface gate. UNSET BY DEFAULT — while unset, POST /admin/reset,
# POST/PUT /admin/business-window and GET /admin/enrolled-users are OPEN.
# Set this on any published/public instance (presented via the X-Admin-Token
# header or Authorization: Bearer <token>).
# ADMIN_TOKEN=change-me

# Business-window enforcement (issues #59, #81, #94). Enforcement is ALWAYS ON
# and spec-driven: each official operation is accessible only in the windows its
# spec lists (e.g. bridge payments = Open for All only; transfer creation = Open
# for All only), derived from the stored business day in Frankfurt
# (Europe/Berlin) time. The default day is Open for All for most of the day, so
# the common flows work at typical hours — but some operations are still
# time-restricted, and outside a valid window a call returns 403 HL-BW-001. Set
# this to "true" to disable enforcement entirely (the "just let me test" switch,
# e.g. CI or demos running at odd hours).
# PONTES_MOCK_BUSINESS_WINDOW_ALWAYS_OPEN=true

# Network id echoed as debitedNetworkID/creditedNetworkID on transfer
# responses — this mock only ever models a single network.
# PONTES_MOCK_NETWORK_ID=mock-pontes

# JWT audience allow-list gating /dlt routes (issue #118). The token endpoint
# accepts any client_id and mints aud=[clientId, "account"]/azp=clientId, but
# only tokens whose aud intersects this comma-separated list pass the gate —
# others get 401 {"status":401,"message":"session is not valid","code":"unauthorized"}.
# Reproduces the real (undocumented) utest behavior where esydlt-web-app tokens
# are rejected on some endpoints despite Table U listing it. See docs/RECIPES.md.
# PONTES_JWT_AUDIENCE_ALLOWLIST=esydlt-web-app-u2a,esydlt-backend-service

# XvP hash-lock commitment method (issue #145). executionHash/cancellationHash
# are SHA-256 of the corresponding key, applying one of two conventions:
#   hex-string (default) — SHA-256 of the UTF-8 bytes of the 64-char lowercase
#     hex wire key itself. Matches what the OpenAPI examples suggest.
#   bytes — SHA-256 of the key's raw decoded 32 bytes (issue #141's original
#     behavior). Matches a verifier that hex-decodes the key before hashing.
# Real Pontes behavior has not been confirmed either way — keep this unset
# (hex-string) unless you are specifically testing the byte convention. An
# unsupported nonempty value fails mock-pontes at startup with a clear error;
# leaving it unset or empty always selects hex-string, never bytes. Only
# affects commitments for XvPs initialized AFTER a (re)start with this value —
# already-issued hashes never change, including across a later value change.
# XVP_HASH_METHOD=hex-string
