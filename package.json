{
  "name": "@digital-assets-work/mock-pontes",
  "description": "A stateful mock of the ECB Pontes (TARGET) A2A API for local development and testing.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/digital-assets-work/mock-pontes.git"
  },
  "type": "module",
  "version": "1.6.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev-tee": "tsx watch src/index.ts 2>&1 | tee /tmp/mock-pontes.log",
    "start": "tsx src/index.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "build": "./ts-esm-build.sh src/index.ts",
    "run": "node ./dist/index.js"
  },
  "dependencies": {
    "@peculiar/x509": "^2.0.0",
    "ajv": "^8.20.0",
    "asn1js": "^3.0.5",
    "dotenv": "^16.0.0",
    "h3": "^1.8.1",
    "jsonwebtoken": "^9.0.3",
    "listhen": "^1.9.0",
    "node-forge": "^1.4.0",
    "pkijs": "^3.4.0",
    "redis": "^4.6.10",
    "reflect-metadata": "^0.2.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/node-forge": "^1.3.14",
    "esbuild": "^0.25.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.4.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "fast-uri": "^3.1.5",
    "js-yaml": "^3.15.1"
  }
}
